<Controllers>
    <Controller name="Cabinet" default="true">
        <!-- Standard buttons -->
        <Mapping name="P1_BUTTON1" input="ButtonA" />
        <Mapping name="P1_BUTTON2" input="ButtonB" />
        <Mapping name="P1_BUTTON3" input="ButtonX" />
        <Mapping name="P1_BUTTON4" input="ButtonY" />
        <Mapping name="P1_BUTTON5" input="ButtonLeftShoulder" />
        <Mapping name="P1_BUTTON6" input="ButtonRightShoulder" />
        <Mapping name="P1_BUTTON7" input="ButtonLeftStick" />
        <Mapping name="P1_BUTTON8" input="ButtonRightStick" />

        <!-- Standard joystick -->
        <Control name="P1_JOYSTICK" mappings="P1_JOYSTICK_UP P1_JOYSTICK_DOWN P1_JOYSTICK_LEFT P1_JOYSTICK_RIGHT" />
        <Mapping name="P1_JOYSTICK_UP" input="ButtonDpadUp" />
        <Mapping name="P1_JOYSTICK_DOWN" input="ButtonDpadDown" />
        <Mapping name="P1_JOYSTICK_LEFT" input="ButtonDpadLeft" />
        <Mapping name="P1_JOYSTICK_RIGHT" input="ButtonDpadRight" />

        <!-- Dual joystick (left) -->
        <Control name="P1_JOYSTICKLEFT" mappings="P1_JOYSTICKLEFT_UP P1_JOYSTICKLEFT_DOWN P1_JOYSTICKLEFT_LEFT P1_JOYSTICKLEFT_RIGHT" />
        <Mapping name="P1_JOYSTICKLEFT_UP" input="AxisLeftStickUp" />
        <Mapping name="P1_JOYSTICKLEFT_DOWN" input="AxisLeftStickDown" />
        <Mapping name="P1_JOYSTICKLEFT_LEFT" input="AxisLeftStickLeft" />
        <Mapping name="P1_JOYSTICKLEFT_RIGHT" input="AxisLeftStickRight" />

        <!-- Dual joystick (right) -->
        <Control name="P1_JOYSTICKRIGHT" mappings="P1_JOYSTICKRIGHT_UP P1_JOYSTICKRIGHT_DOWN P1_JOYSTICKRIGHT_LEFT P1_JOYSTICKRIGHT_RIGHT" />
        <Mapping name="P1_JOYSTICKRIGHT_UP" input="AxisRightStickUp" />
        <Mapping name="P1_JOYSTICKRIGHT_DOWN" input="AxisRightStickDown" />
        <Mapping name="P1_JOYSTICKRIGHT_LEFT" input="AxisRightStickLeft" />
        <Mapping name="P1_JOYSTICKRIGHT_RIGHT" input="AxisRightStickRight" />

        <!-- Analog stick -->
        <Control name="P1_AD_STICK_X" mappings="P1_AD_STICK_X.dec P1_AD_STICK_X.inc" />
        <Mapping name="P1_AD_STICK_X.dec" input="AxisLeftStickLeft" />
        <Mapping name="P1_AD_STICK_X.inc" input="AxisLeftStickRight" />
        <Control name="P1_AD_STICK_Y" mappings="P1_AD_STICK_Y.dec P1_AD_STICK_Y.inc" />
        <Mapping name="P1_AD_STICK_Y.dec" input="AxisLeftStickUp" />
        <Mapping name="P1_AD_STICK_Y.inc" input="AxisLeftStickDown" />
        <Control name="P1_AD_STICK_Z" mappings="P1_AD_STICK_Z.dec P1_AD_STICK_Z.inc" />
        <Mapping name="P1_AD_STICK_Z.dec" input="AxisRightStickUp" />
        <Mapping name="P1_AD_STICK_Z.inc" input="AxisRightStickDown" />

        <!-- Pedals -->
        <Mapping name="P1_PEDAL" input="AxisTriggerRight" />
        <Mapping name="P1_PEDAL2" input="AxisTriggerLeft" />

        <!-- Paddle -->
        <Control name="P1_PADDLE" mappings="P1_PADDLE.dec P1_PADDLE.inc" />
        <Mapping name="P1_PADDLE.dec" input="AxisLeftStickLeft" />
        <Mapping name="P1_PADDLE.inc" input="AxisLeftStickRight" />
        <Control name="P1_PADDLE_V" mappings="P1_PADDLE_V.dec P1_PADDLE_V.inc" />
        <Mapping name="P1_PADDLE_V.dec" input="AxisLeftStickUp" />
        <Mapping name="P1_PADDLE_V.inc" input="AxisLeftStickDown" />

        <!-- Dial -->
        <Control name="P1_DIAL" mappings="P1_DIAL.dec P1_DIAL.inc" />
        <Mapping name="P1_DIAL.dec" input="AxisLeftStickLeft" />
        <Mapping name="P1_DIAL.inc" input="AxisLeftStickRight" />
        <Control name="P1_DIAL_V" mappings="P1_DIAL_V.dec P1_DIAL_V.inc" />
        <Mapping name="P1_DIAL_V.dec" input="AxisLeftStickUp" />
        <Mapping name="P1_DIAL_V.inc" input="AxisLeftStickDown" />

        <!-- Trackball -->
        <Control name="P1_TRACKBALL_X" mappings="P1_TRACKBALL_X.dec P1_TRACKBALL_X.inc" />
        <Mapping name="P1_TRACKBALL_X.dec" input="AxisLeftStickLeft" />
        <Mapping name="P1_TRACKBALL_X.inc" input="AxisLeftStickRight" />
        <Control name="P1_TRACKBALL_Y" mappings="P1_TRACKBALL_Y.dec P1_TRACKBALL_Y.inc" />
        <Mapping name="P1_TRACKBALL_Y.dec" input="AxisLeftStickUp" />
        <Mapping name="P1_TRACKBALL_Y.inc" input="AxisLeftStickDown" />

        <!-- Lightgun -->
        <Control name="P1_LIGHTGUN_X" mappings="P1_LIGHTGUN_X.dec P1_LIGHTGUN_X.inc" />
        <Mapping name="P1_LIGHTGUN_X.dec" input="AxisRightStickLeft" />
        <Mapping name="P1_LIGHTGUN_X.inc" input="AxisRightStickRight" />
        <Control name="P1_LIGHTGUN_Y" mappings="P1_LIGHTGUN_Y.dec P1_LIGHTGUN_Y.inc" />
        <Mapping name="P1_LIGHTGUN_Y.dec" input="AxisRightStickUp" />
        <Mapping name="P1_LIGHTGUN_Y.inc" input="AxisRightStickDown" />

        <!-- System buttons -->
        <Mapping name="START1" input="ButtonStart" />
        <Mapping name="COIN1" input="ButtonBack" />
    </Controller>
</Controllers>
