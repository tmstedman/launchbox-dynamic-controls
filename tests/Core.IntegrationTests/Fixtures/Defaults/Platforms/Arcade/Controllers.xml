<Controllers>
    <Controller name="Cabinet" default="true">
        <!-- Standard buttons -->
        <Mapping name="P1_BUTTON1" input="ButtonA" />
        <Mapping name="P1_BUTTON2" input="ButtonB" />
        <Mapping name="P1_BUTTON3" input="ButtonX" />
        <Mapping name="P1_BUTTON4" input="ButtonY" />
        <Mapping name="P1_BUTTON5" input="ButtonLeftShoulder" />
        <Mapping name="P1_BUTTON6" input="ButtonRightShoulder" />
        <Mapping name="P1_BUTTON7" input="AxisTriggerLeft" />
        <Mapping name="P1_BUTTON8" input="AxisTriggerRight" />
        <Mapping name="P1_BUTTON9" input="ButtonLeftStick" />
        <Mapping name="P1_BUTTON10" input="ButtonRightStick" />

        <!-- Standard joystick -->
        <Mapping name="P1_JOYSTICK" input="ButtonDpad" />
        <Mapping name="P1_JOYSTICK_UP" input="ButtonDpadUp" />
        <Mapping name="P1_JOYSTICK_DOWN" input="ButtonDpadDown" />
        <Mapping name="P1_JOYSTICK_LEFT" input="ButtonDpadLeft" />
        <Mapping name="P1_JOYSTICK_RIGHT" input="ButtonDpadRight" />

        <!-- Dual joystick (left) -->
        <Mapping name="P1_JOYSTICKLEFT" input="AxisLeftStick" />
        <Mapping name="P1_JOYSTICKLEFT_UP" input="AxisLeftStickUp" />
        <Mapping name="P1_JOYSTICKLEFT_DOWN" input="AxisLeftStickDown" />
        <Mapping name="P1_JOYSTICKLEFT_LEFT" input="AxisLeftStickLeft" />
        <Mapping name="P1_JOYSTICKLEFT_RIGHT" input="AxisLeftStickRight" />

        <!-- Dual joystick (right) -->
        <Mapping name="P1_JOYSTICKRIGHT" input="AxisRightStick" />
        <Mapping name="P1_JOYSTICKRIGHT_UP" input="AxisRightStickUp" />
        <Mapping name="P1_JOYSTICKRIGHT_DOWN" input="AxisRightStickDown" />
        <Mapping name="P1_JOYSTICKRIGHT_LEFT" input="AxisRightStickLeft" />
        <Mapping name="P1_JOYSTICKRIGHT_RIGHT" input="AxisRightStickRight" />

        <!-- Analog stick -->
        <Mapping name="P1_AD_STICK_X" input="AxisLeftStickLeft" />
        <Mapping name="P1_AD_STICK_X" input="AxisLeftStickRight" />
        <Mapping name="P1_AD_STICK_Y" input="AxisLeftStickUp" />
        <Mapping name="P1_AD_STICK_Y" input="AxisLeftStickDown" />
        <Mapping name="P1_AD_STICK_Z" input="AxisRightStickUp" />
        <Mapping name="P1_AD_STICK_Z" input="AxisRightStickDown" />

        <!-- Pedals -->
        <Mapping name="P1_PEDAL" input="AxisTriggerRight" />
        <Mapping name="P1_PEDAL2" input="AxisTriggerLeft" />

        <!-- Paddle -->
        <Mapping name="P1_PADDLE" input="AxisLeftStickLeft" />
        <Mapping name="P1_PADDLE" input="AxisLeftStickRight" />
        <Mapping name="P1_PADDLE_V" input="AxisLeftStickUp" />
        <Mapping name="P1_PADDLE_V" input="AxisLeftStickDown" />

        <!-- Dial -->
        <Mapping name="P1_DIAL" input="AxisLeftStickLeft" />
        <Mapping name="P1_DIAL" input="AxisLeftStickRight" />
        <Mapping name="P1_DIAL_V" input="AxisLeftStickUp" />
        <Mapping name="P1_DIAL_V" input="AxisLeftStickDown" />

        <!-- Trackball -->
        <Mapping name="P1_TRACKBALL_X" input="AxisLeftStickLeft" />
        <Mapping name="P1_TRACKBALL_X" input="AxisLeftStickRight" />
        <Mapping name="P1_TRACKBALL_Y" input="AxisLeftStickUp" />
        <Mapping name="P1_TRACKBALL_Y" input="AxisLeftStickDown" />

        <!-- Positional -->
        <Mapping name="P1_POSITIONAL" input="AxisLeftStickLeft" />
        <Mapping name="P1_POSITIONAL" input="AxisLeftStickRight" />
        <Mapping name="P1_POSITIONAL_V" input="AxisLeftStickUp" />
        <Mapping name="P1_POSITIONAL_V" input="AxisLeftStickDown" />

        <!-- Lightgun -->
        <Mapping name="P1_LIGHTGUN_X" input="AxisRightStickLeft" />
        <Mapping name="P1_LIGHTGUN_X" input="AxisRightStickRight" />
        <Mapping name="P1_LIGHTGUN_Y" input="AxisRightStickUp" />
        <Mapping name="P1_LIGHTGUN_Y" input="AxisRightStickDown" />

        <!-- System buttons -->
        <Mapping name="START" input="ButtonStart" />
        <Mapping name="COIN" input="ButtonBack" />
    </Controller>
</Controllers>
