<Labels>
  <Defaults>
    <Input name="Start">Pause</Input>
  </Defaults>
  <Game romName="Goldeneye 007">
    <Input name="B">Weapon</Input>
    <Input name="A">Action</Input>
    <Input name="L">Aim</Input>
    <Input name="R">Aim</Input>
    <Input name="Z">Fire</Input>
    <Input name="Stick-Any">Look</Input>
    <Input name="Dpad-Any">Move</Input>
    <Input name="C-Any">Move</Input>
  </Game>
  <!-- C-buttons labelled one direction at a time rather than through C-Any, with the
       horizontal pair agreeing: the only fixture that reaches AxisRightStick's axis-pair
       alternative, since every other platform labels that control as a whole or not at all. -->
  <Game romName="CDirectionPairTest">
    <Input name="C-Up">Look Up</Input>
    <Input name="C-Down">Look Down</Input>
    <Input name="C-Left">Strafe</Input>
    <Input name="C-Right">Strafe</Input>
  </Game>
  <!-- The vertical counterpart: Up and Down agree, Left and Right do not. -->
  <Game romName="CVerticalPairTest">
    <Input name="C-Up">Look</Input>
    <Input name="C-Down">Look</Input>
    <Input name="C-Left">Strafe Left</Input>
    <Input name="C-Right">Strafe Right</Input>
  </Game>
  <!-- CDirectionPairTest with C-Left and C-Right swapped in ControllerOverrides: each now drives
       the other's direction, so the same two buttons stand behind the horizontal pair. -->
  <Game romName="CSwapPairTest">
    <Input name="C-Up">Look Up</Input>
    <Input name="C-Down">Look Down</Input>
    <Input name="C-Left">Strafe</Input>
    <Input name="C-Right">Strafe</Input>
  </Game>
</Labels>
