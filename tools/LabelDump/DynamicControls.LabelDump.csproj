<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer tool, not part of the shipped plugin. Deliberately absent from both .slnx files
    and from every csproj CI builds, so the release stays exactly two DLLs and this project's
    existence can never affect coverage, packaging, or the LaunchBox publish. Run it via
    "dotnet run" against this project; see Options.cs for the arguments and an example.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>DynamicControls.LabelDump</RootNamespace>
    <AssemblyName>DynamicControls.LabelDump</AssemblyName>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable;CS8509</WarningsAsErrors>
    <NoWarn>CS8524</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\DynamicControls.Core.csproj" />
  </ItemGroup>

</Project>
