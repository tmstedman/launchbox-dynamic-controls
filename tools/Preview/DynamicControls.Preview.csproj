<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer tool, not part of the shipped plugin. Nothing CI runs references it: every workflow
    step names a csproj directly: the two test projects, then "dotnet publish src/LaunchBox",
    so coverage, packaging and the release artifact are all decided without it. Being listed in a
    .slnx is therefore an editor convenience and nothing more; what keeps the tool out of the
    release is that no shipped project references it.

    Running "dotnet test DynamicControls.Core.slnx" does build it, since that builds the whole
    solution. A compile error here will fail that command, which is the one cost of listing it.

    SkiaSharp is why this lives under tools/ rather than beside the renderer: src/ carries no
    NuGet dependencies at all, which is what keeps the shipped plugin to two DLLs. Listing this
    project in a solution pulls that restore, native assets included, into any build of it.

    Run it with "dotnet run" against this project; see the Usage text for the arguments.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>DynamicControls.Preview</RootNamespace>
    <AssemblyName>DynamicControls.Preview</AssemblyName>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable;CS8509</WarningsAsErrors>
    <NoWarn>CS8524</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\DynamicControls.Core.csproj" />
    <ProjectReference Include="..\Common\DynamicControls.Tools.Common.csproj" />
  </ItemGroup>

</Project>
