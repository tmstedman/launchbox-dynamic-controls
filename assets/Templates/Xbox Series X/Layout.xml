<ControllerTemplate>
    <Head>
        <Style fontSize="24" inactiveBlurRadius="8" />
        <Style name="auto-blur" showIf="auto" minOpacity="0.3" />
        <Style name="mapped-input-blur" showIf="mapping" minOpacity="0.3" inactiveBlurRadius="6" />
        <Style name="small-label-blur" showIf="label" minOpacity="0.3" inactiveBlurRadius="6" fontSize="22" />
        <Style name="small-label-vacate" showIf="label" inactiveBlurRadius="6" fontSize="22" />
        <Style name="input-label" showIf="label" minOpacity="0.3" inactiveBlurRadius="8" />
        <Style name="show-if-label" showIf="label" />
    </Head>
    <Body>
        <Input name="ButtonGuide" style="auto-blur" x="771" y="262" height="68" width="68" />
        <Input name="AxisTriggerLeft" style="auto-blur" x="307" y="116" height="65" width="65">
            <Overlay src="Line_AxisTriggerLeft.png" x="+81" y="+30" />
            <Label x="-19" y="+32" align="right" />
        </Input>
        <Input name="ButtonLeftShoulder" style="auto-blur" x="307" y="203" height="42" width="64">
            <Overlay src="Line_ButtonLeftShoulder.png" x="+85" y="+24" />
            <Label x="-19" y="+21" align="right" />
        </Input>
        <Input name="AxisTriggerRight" style="auto-blur" x="1228" y="116" height="65" width="65">
            <Overlay src="Line_AxisTriggerRight.png" x="-207" y="+30" />
            <Label x="+81" y="+32" />
        </Input>
        <Input name="ButtonRightShoulder" style="auto-blur" x="1229" y="203" height="42" width="64">
            <Overlay src="Line_ButtonRightShoulder.png" x="-144" y="+24" />
            <Label x="+80" y="+21" />
        </Input>
        <Input name="ButtonY" style="auto-blur" x="970" y="292" height="64" width="64" />
        <Input name="ButtonX" style="auto-blur" x="912" y="345" height="64" width="64" />
        <Input name="ButtonA" style="auto-blur" x="970" y="401" height="64" width="64" />
        <Input name="ButtonB" style="auto-blur" x="1026" y="350" height="64" width="64" />
        <Input name="ButtonStart" style="mapped-input-blur" x="832" y="356" height="44" width="44" />
        <Input name="ButtonBack" style="mapped-input-blur" x="714" y="356" height="44" width="44" />
        <!-- A Container never decides its own inclusion, so this explicit Condition is what
             replaces the old Group's implicit "any member visible" check: without it, this
             cluster would fade to the template default instead of disappearing entirely when
             neither button has a label. -->
        <Condition any="ButtonStart ButtonBack" match="label">
            <Overlay src="Line_MetaButtons.png" x="703" y="406" />
            <Container x="666" y="661" gap="45" style="small-label-blur">
                <Input name="ButtonStart" height="34" width="34">
                    <Label x="+51" y="+17" />
                </Input>
                <Input name="ButtonBack" height="34" width="34">
                    <Label x="+51" y="+17" />
                </Input>
            </Container>
        </Condition>
        <!-- Same reasoning as the meta-buttons cluster above. -->
        <Condition any="ButtonY ButtonB ButtonA ButtonX" match="label">
            <Container x="1249" y="318" gap="80">
                <Input name="ButtonY" style="input-label" height="44" width="44">
                    <Overlay src="Line_ButtonY.png" x="-209" y="+5" />
                    <Label x="+60" y="+22" />
                </Input>
                <Input name="ButtonB" style="input-label" height="44" width="44">
                    <Overlay src="Line_ButtonB.png" x="-166" y="+13" />
                    <Label x="+60" y="+22" />
                </Input>
                <Input name="ButtonA" style="input-label" height="44" width="44">
                    <Overlay src="Line_ButtonA.png" x="-218" y="-18" />
                    <Label x="+60" y="+22" />
                </Input>
                <Input name="ButtonX" style="input-label" height="44" width="44">
                    <Overlay src="Line_ButtonX.png" x="-304" y="-142" />
                    <Label x="+60" y="+22" />
                </Input>
            </Container>
        </Condition>
        <Input name="ButtonLeftStick" style="show-if-label" x="307" y="477" height="44" width="44">
            <Overlay src="Line_ButtonLeftStick.png" x="+80" y="-56" />
            <Label x="-19" y="+22" align="right" />
        </Input>
        <Input name="ButtonRightStick" style="show-if-label" x="1249" y="658" height="44" width="44">
            <Overlay src="Line_ButtonRightStick.png" x="-298" y="-108" />
            <Label x="+60" y="+22" />
        </Input>
        <Input name="AxisLeftStick" style="auto-blur" x="539" y="309" height="124" width="124" />
        <OneOf>
            <!-- All four directions individually agree: the stick doesn't have a per-direction
                 glyph the way the Dpad does, so a full agreement renders the single stick icon
                 rather than four small ones. The outer Condition (whole itself collapsed) is
                 required alongside the inner one (all four individually labelled) — on its
                 own, "all four individually labelled" is also true when all four genuinely
                 disagree, which must fall through to the all-distinct alternative instead. -->
            <Condition any="AxisLeftStick" match="label">
                <Condition all="AxisLeftStickUp AxisLeftStickDown AxisLeftStickLeft AxisLeftStickRight" match="label">
                    <Input name="AxisLeftStick" style="show-if-label" x="307" y="339" height="64" width="64">
                        <Overlay src="Line_AxisLeftStick.png" x="+79" y="+31" />
                        <Label x="-19" y="+32" align="right" />
                    </Input>
                </Condition>
            </Condition>
            <!-- Two or three directions share one label, the rest genuinely blank: only the
                 present directions render, each at full brightness, with one shared label.
                 The label lives loose inside the Group, so it always centers on however many
                 directions actually survive this game, for any vAlign — the y="+17" below is
                 a small manual nudge on top of that computed center, not a replacement for it. -->
            <Condition any="AxisLeftStick" match="label">
                <Overlay src="Line_AxisLeftStick_Multi.png" x="386" y="370" />
                <Container for="AxisLeftStick" x="312" y="358.5" gap="45" collapse="true" vAlign="center" style="small-label-vacate">
                    <Label x="-24" y="+17" align="right" fontSize="24" />
                    <Input name="AxisLeftStickUp" height="34" width="34" />
                    <Input name="AxisLeftStickLeft" height="34" width="34" />
                    <Input name="AxisLeftStickRight" height="34" width="34" />
                    <Input name="AxisLeftStickDown" height="34" width="34" />
                </Container>
            </Condition>
            <!-- Fallback: no two directions agree — each renders its own, independent text.
                 A Container never decides its own inclusion, so this explicit Condition is what
                 replaces the old Group's implicit "any member visible" check: without it, the
                 OneOf could never select this alternative at all, having no other way to ask
                 whether it has anything to show. -->
            <Condition any="AxisLeftStickUp AxisLeftStickLeft AxisLeftStickRight AxisLeftStickDown" match="label">
                <Overlay src="Line_AxisLeftStick_Multi.png" x="386" y="370" />
                <Container x="312" y="358.5" gap="45" collapse="true" vAlign="center" style="small-label-vacate">
                    <Input name="AxisLeftStickUp" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                    <Input name="AxisLeftStickLeft" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                    <Input name="AxisLeftStickRight" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                    <Input name="AxisLeftStickDown" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                </Container>
            </Condition>
        </OneOf>
        <Input name="AxisRightStick" style="auto-blur" x="839" y="438" height="124" width="124" />
        <OneOf>
            <!-- All four directions individually agree: render the single stick icon. See
                 AxisLeftStick above for why this needs both the outer and inner Condition. -->
            <Condition any="AxisRightStick" match="label">
                <Condition all="AxisRightStickUp AxisRightStickDown AxisRightStickLeft AxisRightStickRight" match="label">
                    <Input name="AxisRightStick" style="show-if-label" x="867" y="740" height="64" width="64">
                        <Overlay src="Line_AxisRightStick.png" x="+31" y="-170" />
                        <Label x="+32" y="+88" align="center" />
                    </Input>
                </Condition>
            </Condition>
            <!-- Two or three directions share one label, the rest genuinely blank: same
                 mechanism as AxisLeftStick above, but this Group has no vAlign (defaults to
                 "top"), and its y="+15" is its own manual nudge on top of the computed center. -->
            <Condition any="AxisRightStick" match="label">
                <Overlay src="Line_AxisRightStick_Multi.png" x="898" y="575" />
                <Container for="AxisRightStick" x="882" y="772" gap="45" collapse="true" style="small-label-vacate">
                    <Label x="+52" y="+15" fontSize="24" />
                    <Input name="AxisRightStickUp" useImage="AxisLeftStickUp" height="34" width="34" />
                    <Input name="AxisRightStickLeft" useImage="AxisLeftStickLeft" height="34" width="34" />
                    <Input name="AxisRightStickRight" useImage="AxisLeftStickRight" height="34" width="34" />
                    <Input name="AxisRightStickDown" useImage="AxisLeftStickDown" height="34" width="34" />
                </Container>
            </Condition>
            <!-- Fallback: no two directions agree — each renders its own, independent text.
                 See AxisLeftStick above for why this needs an explicit Condition now. -->
            <Condition any="AxisRightStickUp AxisRightStickLeft AxisRightStickRight AxisRightStickDown" match="label">
                <Overlay src="Line_AxisRightStick_Multi.png" x="898" y="575" />
                <Container x="882" y="772" gap="45" collapse="true" style="small-label-vacate">
                    <Input name="AxisRightStickUp" useImage="AxisLeftStickUp" height="34" width="34">
                        <Label x="+52" y="+15" />
                    </Input>
                    <Input name="AxisRightStickLeft" useImage="AxisLeftStickLeft" height="34" width="34">
                        <Label x="+52" y="+15" />
                    </Input>
                    <Input name="AxisRightStickRight" useImage="AxisLeftStickRight" height="34" width="34">
                        <Label x="+52" y="+15" />
                    </Input>
                    <Input name="AxisRightStickDown" useImage="AxisLeftStickDown" height="34" width="34">
                        <Label x="+52" y="+15" />
                    </Input>
                </Container>
            </Condition>
        </OneOf>
        <Input name="ButtonDpad" style="auto-blur" x="623" y="440" height="135" width="135" />
        <OneOf>
            <!-- Two or more directions share one label, the rest genuinely blank: render only
                 the directions that are actually present, each at full brightness, with one
                 shared label rather than repeating it next to every agreeing icon. Covers a
                 full four-way agreement too, in the same shape as a partial one. -->
            <Condition any="ButtonDpad" match="label">
                <Overlay src="Line_ButtonDpad_Multi.png" x="384" y="507" />
                <Container for="ButtonDpad" x="312" y="619.5" gap="45" collapse="true" vAlign="center" style="small-label-vacate">
                    <Label x="-24" y="+17" align="right" fontSize="24" />
                    <Input name="ButtonDpadUp" height="34" width="34" />
                    <Input name="ButtonDpadLeft" height="34" width="34" />
                    <Input name="ButtonDpadRight" height="34" width="34" />
                    <Input name="ButtonDpadDown" height="34" width="34" />
                </Container>
            </Condition>
            <!-- Fallback: no two directions agree (or nothing's labelled at all) — each
                 direction renders its own, independent text. See AxisLeftStick above for why
                 this needs an explicit Condition now. -->
            <Condition any="ButtonDpadUp ButtonDpadLeft ButtonDpadRight ButtonDpadDown" match="label">
                <Overlay src="Line_ButtonDpad_Multi.png" x="384" y="507" />
                <Container x="312" y="619.5" gap="45" collapse="true" vAlign="center" style="small-label-vacate">
                    <Input name="ButtonDpadUp" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                    <Input name="ButtonDpadLeft" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                    <Input name="ButtonDpadRight" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                    <Input name="ButtonDpadDown" height="34" width="34">
                        <Label x="-24" y="+17" align="right" />
                    </Input>
                </Container>
            </Condition>
        </OneOf>
    </Body>
</ControllerTemplate>
