<?xml version="1.0" encoding="utf-8"?>
<JoycodeMapping>

  <!-- Face buttons -->
  <Mapping joycode="JOYCODE_1_BUTTON1" input="ButtonA" />
  <Mapping joycode="JOYCODE_1_BUTTON2" input="ButtonB" />
  <Mapping joycode="JOYCODE_1_BUTTON3" input="ButtonX" />
  <Mapping joycode="JOYCODE_1_BUTTON4" input="ButtonY" />
  <Mapping joycode="JOYCODE_1_BUTTON5" input="ButtonLeftShoulder" />
  <Mapping joycode="JOYCODE_1_BUTTON6" input="ButtonRightShoulder" />
  <Mapping joycode="JOYCODE_1_BUTTON7" input="ButtonLeftStick" />
  <Mapping joycode="JOYCODE_1_BUTTON8" input="ButtonRightStick" />

  <!-- D-pad (POV hat). On modern XInput controllers, the d-pad reports as HAT1. -->
  <Mapping joycode="JOYCODE_1_HAT1UP" input="ButtonDpadUp" />
  <Mapping joycode="JOYCODE_1_HAT1DOWN" input="ButtonDpadDown" />
  <Mapping joycode="JOYCODE_1_HAT1LEFT" input="ButtonDpadLeft" />
  <Mapping joycode="JOYCODE_1_HAT1RIGHT" input="ButtonDpadRight" />

  <!-- Left stick. XAXIS/YAXIS are the left-stick axes; the _SWITCH variants are the same
       axes used as digital triggers (e.g. MAME records this when "Type a key" sees the
       analog stick crossing a threshold) — still the left stick physically.

       axis= and end= on a _SWITCH say which end of which axis it is, here and on the right
       stick below. Two switches naming the same axis and opposite ends are its two ends, so a
       nudged dial bound to one in each sequence is the stick turning it both ways. The axis
       value is only a label the two ends share: it is compared, never looked up, so it ties
       nothing to the bare axis's halves further down. end uses the same words as half
       (dec = left/up, inc = right/down) but is not one: a switch is not half of an axis a
       nudge can borrow. A code without them, like a button, a hat or a trigger, is the end
       of no axis. -->
  <Mapping joycode="JOYCODE_1_XAXIS_LEFT" input="AxisLeftStickLeft" />
  <Mapping joycode="JOYCODE_1_XAXIS_RIGHT" input="AxisLeftStickRight" />
  <Mapping joycode="JOYCODE_1_YAXIS_UP" input="AxisLeftStickUp" />
  <Mapping joycode="JOYCODE_1_YAXIS_DOWN" input="AxisLeftStickDown" />
  <Mapping joycode="JOYCODE_1_XAXIS_LEFT_SWITCH" axis="JOYCODE_1_XAXIS" end="dec" input="AxisLeftStickLeft" />
  <Mapping joycode="JOYCODE_1_XAXIS_RIGHT_SWITCH" axis="JOYCODE_1_XAXIS" end="inc" input="AxisLeftStickRight" />
  <Mapping joycode="JOYCODE_1_YAXIS_UP_SWITCH" axis="JOYCODE_1_YAXIS" end="dec" input="AxisLeftStickUp" />
  <Mapping joycode="JOYCODE_1_YAXIS_DOWN_SWITCH" axis="JOYCODE_1_YAXIS" end="inc" input="AxisLeftStickDown" />

  <!-- Right stick (DirectInput) -->
  <Mapping joycode="JOYCODE_1_RXAXIS_NEG" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_RXAXIS_POS" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RYAXIS_NEG" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RYAXIS_POS" input="AxisRightStickDown" />
  <Mapping joycode="JOYCODE_1_RXAXIS_NEG_SWITCH" axis="JOYCODE_1_RXAXIS" end="dec" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_RXAXIS_POS_SWITCH" axis="JOYCODE_1_RXAXIS" end="inc" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RYAXIS_NEG_SWITCH" axis="JOYCODE_1_RYAXIS" end="dec" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RYAXIS_POS_SWITCH" axis="JOYCODE_1_RYAXIS" end="inc" input="AxisRightStickDown" />

  <!-- Right stick (XInput). -->
  <Mapping joycode="JOYCODE_1_ZAXIS_NEG" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_ZAXIS_POS" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RZAXIS_NEG" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RZAXIS_POS" input="AxisRightStickDown" />
  <Mapping joycode="JOYCODE_1_ZAXIS_NEG_SWITCH" axis="JOYCODE_1_ZAXIS" end="dec" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_ZAXIS_POS_SWITCH" axis="JOYCODE_1_ZAXIS" end="inc" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RZAXIS_NEG_SWITCH" axis="JOYCODE_1_RZAXIS" end="dec" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RZAXIS_POS_SWITCH" axis="JOYCODE_1_RZAXIS" end="inc" input="AxisRightStickDown" />

  <!-- Trigger slider axes (XInput) -->
  <Mapping joycode="JOYCODE_1_SLIDER1_NEG_SWITCH" input="AxisTriggerLeft" />
  <Mapping joycode="JOYCODE_1_SLIDER2_NEG_SWITCH" input="AxisTriggerRight" />

  <!-- Bare analogue axes (no _SWITCH/_NEG/_POS suffix). MAME's true analogue ports — DIAL,
       AD_STICK_X/Y, PADDLE, TRACKBALL_X/Y, LIGHTGUN_X/Y — read the axis directly rather than
       thresholding it into a digital switch, so the token itself carries no sign. Both halves
       are declared against the same joycode, and half= states which end of it each one is:
       a port bound to the axis reaches both ends, and anything naming one end alone takes
       only that one. -->
  <Mapping joycode="JOYCODE_1_XAXIS" half="dec" input="AxisLeftStickLeft" />
  <Mapping joycode="JOYCODE_1_XAXIS" half="inc" input="AxisLeftStickRight" />
  <Mapping joycode="JOYCODE_1_YAXIS" half="dec" input="AxisLeftStickUp" />
  <Mapping joycode="JOYCODE_1_YAXIS" half="inc" input="AxisLeftStickDown" />

  <!-- (XInput) -->
  <Mapping joycode="JOYCODE_1_ZAXIS" half="dec" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_ZAXIS" half="inc" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RZAXIS" half="dec" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RZAXIS" half="inc" input="AxisRightStickDown" />

  <!-- (DirectInput)-->
  <Mapping joycode="JOYCODE_1_RXAXIS" half="dec" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_RXAXIS" half="inc" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RYAXIS" half="dec" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RYAXIS" half="inc" input="AxisRightStickDown" />

  <!-- Inverted analogue axes. MAME appends _REVERSE when an axis is read the other way round,
       usually a flight-style pitch control. Each resolves exactly as its plain form above: the
       bare joycode carries no sign, so both halves are already declared against it — these
       simply declare them the other way round, which is the whole of what reversing an axis
       means. Stating the halves in data is what keeps _REVERSE a spelling the code never
       has to recognise. Without these the token matches nothing and the port silently
       resolves to no control at all.

       Every axis that has a plain form above has its reversed form here, including the ones no
       cfg in the reference pack happens to use: the cost of a spare line is nothing, and the
       cost of a missing one is a control that vanishes with no error. A reversed slider takes
       the single input its one-directional plain form does, for the same reason. -->
  <Mapping joycode="JOYCODE_1_XAXIS_REVERSE" half="inc" input="AxisLeftStickLeft" />
  <Mapping joycode="JOYCODE_1_XAXIS_REVERSE" half="dec" input="AxisLeftStickRight" />
  <Mapping joycode="JOYCODE_1_YAXIS_REVERSE" half="inc" input="AxisLeftStickUp" />
  <Mapping joycode="JOYCODE_1_YAXIS_REVERSE" half="dec" input="AxisLeftStickDown" />

  <!-- (XInput) -->
  <Mapping joycode="JOYCODE_1_ZAXIS_REVERSE" half="inc" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_ZAXIS_REVERSE" half="dec" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RZAXIS_REVERSE" half="inc" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RZAXIS_REVERSE" half="dec" input="AxisRightStickDown" />

  <!-- (DirectInput)-->
  <Mapping joycode="JOYCODE_1_RXAXIS_REVERSE" half="inc" input="AxisRightStickLeft" />
  <Mapping joycode="JOYCODE_1_RXAXIS_REVERSE" half="dec" input="AxisRightStickRight" />
  <Mapping joycode="JOYCODE_1_RYAXIS_REVERSE" half="inc" input="AxisRightStickUp" />
  <Mapping joycode="JOYCODE_1_RYAXIS_REVERSE" half="dec" input="AxisRightStickDown" />

  <Mapping joycode="JOYCODE_1_SLIDER1_REVERSE" input="AxisTriggerLeft" />
  <Mapping joycode="JOYCODE_1_SLIDER2_REVERSE" input="AxisTriggerRight" />

  <!-- Bare trigger sliders. A pedal travels rest-to-floor, one direction only, not a two-way
       axis like the sticks above — it needs just the one input the _SWITCH variant already uses. -->
  <Mapping joycode="JOYCODE_1_SLIDER1_NEG" input="AxisTriggerLeft" />
  <Mapping joycode="JOYCODE_1_SLIDER2_NEG" input="AxisTriggerRight" />

  <!-- Start / Select -->
  <Mapping joycode="JOYCODE_1_START" input="ButtonStart" />
  <Mapping joycode="JOYCODE_1_SELECT" input="ButtonBack" />

</JoycodeMapping>
